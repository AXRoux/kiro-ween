# Wrapper reading (when there is no barcode, and to check the wrapper is sealed). One of these is enough;
# without either, barcode scanning with Open Food Facts still works.
# In the desktop app, place this file in ~/Library/Application Support/Trick or Read/.env (macOS),
# %APPDATA%\Trick or Read\.env (Windows), or ~/.config/Trick or Read/.env (Linux).
FAL_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider (fal | anthropic) and a model.
# Defaults: fal -> anthropic/claude-haiku-5.5, anthropic -> claude-sonnet-5-5
VISION_PROVIDER=
CANDY_MODEL=
# Optional: API port (default 8787). TRUST_PROXY=1 only behind a proxy that overwrites X-Forwarded-For.
PORT=
TRUST_PROXY=
# Bind address. Default 127.0.0.1. Set to 0.0.0.0 to listen on all interfaces for hosted use.
HOST=
# Your server's origin (e.g. https://example.com). Derived from the Host header if not set.
ORIGIN=
# Optional global cap: max requests per minute to /api/identify across all clients. Off by default.
RATE_LIMIT=
# The castle's voice: Serena and Ana, two young Brazilian women speaking English. Without it the browser's built-in voice is used.
ELEVENLABS_API_KEY=
# Hosted web version (Cloudflare Workers): the same keys are Worker secrets, never files:
#   wrangler secret put FAL_KEY   and   wrangler secret put ELEVENLABS_API_KEY
# RATE_LIMIT there caps wrapper reads per minute across everyone (default 60).
